APP_ENV=development
DATABASE_URL=postgresql://generic_service:change-me@localhost:5432/generic_service_orders
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:5173
ADMIN_PORT=8001
FRONTEND_PORT=5173
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=replace-with-openrouter-api-key
OPENROUTER_MODEL=replace-with-openrouter-model
PROVIDER_MODE=local
PROVIDER_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
# Production also requires HTTPS URLs for MAPS, CALENDAR, MESSAGING,
# PAYMENT, TAX, and ACCOUNTING providers plus PROVIDER_API_TOKEN.
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=replace-with-a-strong-local-password
